[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_test_optimizations"]
script/source = "extends Node2D

func _ready() -> void:
	print('=== RUNNING PERFORMANCE OPTIMIZATIONS & TACTICAL SYSTEMS VERIFICATION ===')
	
	# 1. Verify DecalManager MultiMesh Pooling
	var decal_mgr = get_node_or_null('/root/DecalManager')
	assert(decal_mgr != null, 'DecalManager must be registered as an autoload singleton')
	assert(decal_mgr.MAX_BLOOD_INSTANCES == 1000, 'Blood splat buffer must be 1,000 instances')
	assert(decal_mgr.MAX_CASING_INSTANCES == 1000, 'Bullet casing buffer must be 1,000 instances')
	
	# Spawn blood splats and check circular index
	decal_mgr.spawn_blood_splat(Vector2(100, 100), Vector2.RIGHT)
	assert(decal_mgr.blood_index == 1, 'Blood circular index must advance to 1')
	decal_mgr.spawn_bullet_casing(Vector2(50, 50), Vector2.UP)
	assert(decal_mgr.casing_index == 1, 'Casing circular index must advance to 1')
	print('✔ DecalManager: MultiMesh 1,000-instance blood & debris pooling verified (O(1) allocation)')
	
	# Test Particle Cleanup Policy
	var p = CPUParticles2D.new()
	add_child(p)
	decal_mgr.optimize_particle_emitter(p)
	assert(p.one_shot == true, 'Optimized particle must have one_shot = true')
	assert(p.explosiveness == 1.0, 'Optimized particle must have explosiveness = 1.0')
	p.queue_free()
	print('✔ Particle Cleanup Policy: one_shot, explosiveness 1.0, and auto-queue_free verified')
	
	# 2. Verify AI Pathfinding & Physics Throttling
	var zombie_scene = load('res://scenes/Zombie.tscn')
	var zombie = zombie_scene.instantiate()
	add_child(zombie)
	assert(zombie.get('nav_refresh_timer') != null, 'Zombie must have nav_refresh_timer')
	assert(zombie.get('HIBERNATION_DISTANCE') == 1400.0, 'Hibernation distance must be 1400 units')
	
	# Test Hibernation when player is distant (>1400px)
	var dummy_player = Node2D.new()
	dummy_player.name = 'Player'
	dummy_player.add_to_group('player')
	dummy_player.global_position = Vector2(2500, 2500)
	add_child(dummy_player)
	
	zombie.global_position = Vector2(0, 0)
	zombie.player = dummy_player
	zombie._physics_process(0.016)
	assert(zombie.is_hibernating == true, 'Zombie must enter hibernation when > 1400px away')
	assert(zombie.collision_shape.disabled == true, 'Zombie collision must be disabled during hibernation')
	
	# Bring player within engagement range
	dummy_player.global_position = Vector2(400, 0)
	zombie._physics_process(0.016)
	assert(zombie.is_hibernating == false, 'Zombie must unhibernate within engagement range')
	assert(zombie.collision_shape.disabled == false, 'Zombie collision must be re-enabled')
	print('✔ AI Throttling: Staggered navigation updates and distance-based hibernation verified')
	
	# 3. Verify Tactical Radar / Minimap
	var minimap_scene = load('res://scenes/ui/Minimap.tscn')
	var minimap = minimap_scene.instantiate()
	add_child(minimap)
	assert(minimap.radar_radius == 72.0, 'Radar radius must be configured')
	minimap._process(0.016)
	assert(minimap.sweep_angle > 0.0, 'Radar sweep line must advance')
	print('✔ Tactical Minimap: Math-based 2D radar widget and sweep scan verified (<0.1ms overhead)')
	
	# 4. Verify Tactical Laser Sight
	var laser_scene = load('res://scenes/weapons/LaserSight.tscn')
	var laser = laser_scene.instantiate()
	add_child(laser)
	assert(laser.max_range == 900.0, 'Laser max range must be 900px')
	laser.add_recoil_scatter(0.05)
	assert(laser.target_scatter > 0.0, 'Recoil scatter must be applied to laser beam')
	laser._process(0.016)
	print('✔ Tactical Laser Sight: Dynamic targeting beam, hit marker, and recoil scatter verified')
	
	# 5. Verify Tactical Pause & Settings Drawer
	var pause_scene = load('res://scenes/ui/PauseMenu.tscn')
	var pause_menu = pause_scene.instantiate()
	add_child(pause_menu)
	assert(pause_menu.process_mode == Node.PROCESS_MODE_ALWAYS, 'Pause menu must have PROCESS_MODE_ALWAYS')
	
	# Test Audio Mix volume setting
	pause_menu._set_bus_volume('Master', 80.0)
	var master_vol = pause_menu._get_bus_volume('Master')
	assert(abs(master_vol - 80.0) < 2.0, 'Master volume must be set and retrieved accurately')
	
	# Test Screen Shake setting
	pause_menu._on_shake_changed(75.0)
	assert(Global.screenshake_multiplier == 0.75, 'Global screen shake multiplier must update to 0.75')
	
	# Test Pause toggle
	pause_menu.set_pause_state(true)
	assert(get_tree().paused == true, 'Game tree must pause when pause state is activated')
	assert(pause_menu.visible == true, 'Pause menu must become visible')
	pause_menu.set_pause_state(false)
	assert(get_tree().paused == false, 'Game tree must resume when pause state is deactivated')
	print('✔ Tactical Pause & Settings: Audio mix, graphics toggles, and pause suspension verified')
	
	# Cleanup
	zombie.queue_free()
	dummy_player.queue_free()
	minimap.queue_free()
	laser.queue_free()
	pause_menu.queue_free()
	
	print('=== ALL PERFORMANCE OPTIMIZATIONS & TACTICAL SYSTEM CHECKS PASSED! ===')
	get_tree().quit(0)
"

[node name="TestPerformanceOptimizations" type="Node2D"]
script = SubResource("GDScript_test_optimizations")
